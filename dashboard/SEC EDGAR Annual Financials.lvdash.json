{
  "datasets": [
    {
      "name": "4ae11ac6",
      "displayName": "companies_annual",
      "queryLines": [
        "SELECT\n",
        "  company_name,\n",
        "  initcap(company_name) AS company_display,\n",
        "  sector,\n",
        "  subsector,\n",
        "  period_year,\n",
        "  revenue,\n",
        "  net_income,\n",
        "  net_margin,\n",
        "  revenue / 1000000000 AS revenue_billions,\n",
        "  net_income / 1000000000 AS net_income_billions,\n",
        "  CASE WHEN lower(sector) = 'healthcare' THEN 'Healthcare' ELSE 'Other' END AS sector_group,\n",
        "  ROW_NUMBER() OVER (PARTITION BY period_year ORDER BY revenue DESC) AS rn_rev,\n",
        "  ROW_NUMBER() OVER (PARTITION BY period_year ORDER BY net_income DESC) AS rn_net,\n",
        "  RANK() OVER (PARTITION BY period_year, sector ORDER BY revenue DESC) AS sector_rank\n",
        "FROM edgar.pipeline.gold_company_period\n",
        "WHERE period_type = 'annual'\n",
        "  AND revenue > 0\n",
        "  AND period_year BETWEEN 2023 AND 2025"
      ]
    },
    {
      "name": "78384f93",
      "displayName": "sector_annual",
      "queryLines": [
        "SELECT\n",
        "  sector,\n",
        "  subsector,\n",
        "  period_year,\n",
        "  companies,\n",
        "  total_revenue,\n",
        "  total_net_income,\n",
        "  net_margin,\n",
        "  total_revenue / 1000000000 AS total_revenue_billions,\n",
        "  total_net_income / 1000000000 AS total_net_income_billions,\n",
        "  total_revenue / 1000000000000 AS total_revenue_trillions,\n",
        "  total_net_income / 1000000000000 AS total_net_income_trillions,\n",
        "  CASE\n",
        "    WHEN lower(sector) = 'healthcare' THEN 'Healthcare'\n",
        "    ELSE 'Other'\n",
        "  END AS sector_group\n",
        "FROM\n",
        "  edgar.pipeline.gold_sector_summary\n",
        "WHERE\n",
        "  period_type = 'annual'\n",
        "  AND period_year BETWEEN 2023 AND 2025"
      ],
      "columns": [
        {
          "displayName": "healthcare_revenue_share",
          "description": "Healthcare total revenue as a share of all sectors' revenue (ratio 0-1), computed over rows filtered by dashboard filters",
          "expression": "SUM(CASE WHEN `sector_group` = 'Healthcare' THEN `total_revenue_billions` ELSE 0 END) / NULLIF(SUM(`total_revenue_billions`), 0)"
        }
      ]
    }
  ],
